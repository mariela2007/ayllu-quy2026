# Ayllu · variables de entorno (ninguna es obligatoria: sin ellas la app
# arranca en modo degradado con la semilla en memoria).

# --- Persistencia -----------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# --- Traducción y adaptación ------------------------------------------------
NLLB_API_URL=
NLLB_TIMEOUT=20
HF_API_URL=
HF_API_TOKEN=
LLM_API_URL=
LLM_API_KEY=
LLM_TIMEOUT=20

# --- Escáner de documentos --------------------------------------------------
AYLLU_MAX_UPLOAD_MB=8

# --- Sesión y cuentas de demostración ---------------------------------------
AYLLU_SECRET=cambiar-en-produccion
# Claves de cada rol (sobrescriben las de core/seed.py)
AYLLU_DOCENTE_PASSWORD=ayllu-docente
AYLLU_ESTUDIANTE_PASSWORD=ayllu-estudiante
# AYLLU_DEMO_LOGIN=0 publica el directorio de cuentas sólo cuando interesa
AYLLU_DEMO_LOGIN=1
# AYLLU_REQUIRE_AUTH=1 exige token Bearer en las escrituras
AYLLU_REQUIRE_AUTH=0

# --- Runtime ----------------------------------------------------------------
PORT=5000
FLASK_DEBUG=0
